{
  "name": "tiltmeter-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "eval": "vitest run --project eval",
    "calibration": "pnpm --filter tiltmeter build && node scripts/calibration-report.mjs",
    "calibration:check": "node scripts/calibration-report.mjs --check",
    "ci:pack-check": "node scripts/pack-check.mjs",
    "suite-lint": "pnpm --filter tiltmeter build && node packages/tiltmeter/dist/cli/index.js lint",
    "brand": "node scripts/brand.mjs --project=tiltmeter --out=apps/web/public/brand",
    "diagram": "node scripts/diagram.mjs --out=apps/web/public/diagram",
    "e2e": "pnpm --filter web build && pnpm --filter web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "sharp": "^0.35.3",
    "tiltmeter": "workspace:*",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  }
}
