      "kind": "tool-schema",
      "materialized": {
        "description": "Resolves a package/product name to a Context7-compatible library ID and returns matching libraries. You MUST call this before 'query-docs' to obtain a valid library ID unless the user explicitly provides one in the format '/org/project'.",
